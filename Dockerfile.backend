FROM python:3.11-slim

WORKDIR /app

COPY requirements-backend.txt .
RUN pip install --no-cache-dir -r requirements-backend.txt

COPY core/ ./core/
COPY api/ ./api/
# ต้อง git clone https://github.com/utkusen/promptmap มาไว้ที่ ./promptmap/
# (project root เดียวกับ docker-compose.yml) ก่อน build — ไม่งั้นโฟลเดอร์นี้จะว่าง
# แล้ว promptmap2_runner.py จะหาสคริปต์ promptmap2.py ไม่เจอตอนรันจริง
COPY promptmap/ ./promptmap/

EXPOSE 8000
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]