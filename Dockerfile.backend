# Backend (FastAPI + garak + promptfoo + promptmap2)
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# Node.js (promptfoo เป็น Node CLI) + git (clone promptmap2) + curl (healthcheck)
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl gnupg git \
 && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && rm -rf /var/lib/apt/lists/*

# pin เวอร์ชันที่ verify แล้วบนเครื่องจริง (0.123.1) — มี PR ของ promptfoo ที่จะเปลี่ยนเลข
# alias owasp:llm:NN เป็นฉบับ 2026 อย่าปล่อยให้เป็น latest เงียบๆ
ARG PROMPTFOO_VERSION=0.123.1
RUN npm install -g promptfoo@${PROMPTFOO_VERSION} && npm cache clean --force

WORKDIR /app

COPY requirements-backend.txt .
RUN pip install torch --index-url https://download.pytorch.org/whl/cpu \
 && pip install -r requirements-backend.txt

# promptmap2 (opt-in tool ของ LLM07) — clone ตอน build แทนการต้อง git clone เองก่อนทุกครั้ง
# ปักเวอร์ชันได้ด้วย: docker compose build --build-arg PROMPTMAP_REF=<commit/tag>
ARG PROMPTMAP_REF=""
RUN git clone --depth 1 https://github.com/utkusen/promptmap promptmap \
 && if [ -n "$PROMPTMAP_REF" ]; then \
      git -C promptmap fetch --depth 1 origin "$PROMPTMAP_REF" \
      && git -C promptmap checkout FETCH_HEAD; \
    fi \
 && if [ -f promptmap/requirements.txt ]; then pip install -r promptmap/requirements.txt; fi

COPY core/ ./core/
COPY api/ ./api/

EXPOSE 8000
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]