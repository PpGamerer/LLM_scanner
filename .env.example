# .env.example — copy เป็น .env

# ป้องกันปัญหา grader ตัดสินคำตอบตัวเอง
PROMPTFOO_GRADER_MODEL=llama-guard3:1b

# จำนวน test ต่อ plugin ของ promptfoo
PROMPTFOO_QUICK_TESTS=3
PROMPTFOO_DEEP_TESTS=15

# ตั้ง 1 ถ้าไม่ได้ npm install -g promptfoo (ใช้ npx แทน ช้ากว่ารอบแรก)
PROMPTFOO_USE_NPX=0

PROMPTFOO_STRATEGIES=jailbreak-templates
PROMPTFOO_EMAIL=your-email@example.com

# Ollama URL สำหรับเชื่อมต่อกับ Ollama server
OLLAMA_URL=http://ollama:11434